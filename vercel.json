{
  "outputDirectory": "public",
  "buildCommand": "",
  "redirects": [
    { "source": "/admin", "destination": "/#admin", "permanent": false },
    { "source": "/master", "destination": "/#admin", "permanent": false }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "Permissions-Policy", "value": "camera=(self), microphone=(), geolocation=()" },
      { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
      { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
      { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" }
    ] },
    { "source": "/fonts/(.*)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" } ] },
    { "source": "/vendor/(.*)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" } ] },
    { "source": "/(.*)\\.(png|svg|webmanifest|webp|jpg)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=604800" } ] }
  ]
}
